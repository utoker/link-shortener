# Copy to .env.local and fill in: cp .env.example .env.local

# ── Needed to run ────────────────────────────────────────────────
# Supabase project URL and public anon key (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase secret key, server only: saves links and counts clicks
SUPABASE_SECRET_KEY=

# Upstash Redis for rate limiting
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=

# ── Optional ─────────────────────────────────────────────────────
# Fallback origin for sign-up and password-reset email links,
# used when a request has no Origin header
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Safe Browsing check of new and edited links.
# Without it links are saved unchecked (and the skip is logged).
GOOGLE_SAFE_BROWSING_API_KEY=

# Weekly link check (/api/cron/link-check, scheduled in vercel.json).
# Vercel Cron sends CRON_SECRET as a bearer token; without it the route
# turns every caller away.
CRON_SECRET=
# Resend API key: emails link owners when a link gets blocked,
# and sends the ALERT_EMAIL report
RESEND_API_KEY=
# Where to send a report when a link-check run has problems
ALERT_EMAIL=
# healthchecks.io ping URL, so a missed or failed run gets noticed
HEALTHCHECK_URL=
